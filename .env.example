# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (free tier - no credit card needed, get a key at aistudio.google.com/apikey)
GEMINI_API_KEY=

# PayPal - developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# PayPal billing plan IDs - run `node --env-file=.env.local scripts/setup-paypal-plans.mjs`
# once to create these, then paste the printed IDs here.
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_YEARLY=

# Your deployed site URL (no trailing slash) - used for PayPal return/cancel URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
